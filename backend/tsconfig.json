{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@dream-team/shared": ["../packages/shared/src"]
    }
  },
  "include": ["src/**/*", "tests/**/*"]
}
