{
  "name": "dream-team-builder",
  "private": true,
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "test": "npm run test -w backend && npm run test -w @dream-team/shared",
    "test:e2e": "npm run test:e2e -w frontend",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:push": "npm run db:push -w backend"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
